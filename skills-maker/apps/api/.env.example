# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/skillsmaker?schema=public"

# Auth
JWT_SECRET="change-me-in-production"   # générer : openssl rand -hex 32
JWT_EXPIRES_IN="7d"

# Serveur
PORT=4100
CORS_ORIGIN="http://localhost:5173"

# ── Sources d'offres d'emploi ────────────────────────────────────────────────
# Une source sans clé est simplement masquée côté client (query jobSources).
# Scrapers Apify (Indeed, LinkedIn / HelloWork) — voir plus bas APIFY_API_TOKEN*.
# Sans mots-clés ni lieu, ces sources servent les runs pré-téléchargés de ce dossier
# au lieu de lancer un scraping (aucun crédit consommé au chargement de la page).
JOBS_RUNS_DIR="./data/runs"
# France Travail — compte + application sur https://francetravail.io (API "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""
# Jooble — clé gratuite sur https://jooble.org/api/about (69 pays)
JOOBLE_API_KEY=""

# ── Services portables ───────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_API_KEY_2=""
OPENROUTER_API_KEY=""

APIFY_API_TOKEN=""
APIFY_API_TOKEN_HELLOWORK=""

BREVO_API_KEY=""
BREVO_SMTP_API_KEY=""
BREVO_SENDER_EMAIL=""

MAKE_WELCOME_WEBHOOK_URL=""

# ── Supabase — TEMPORAIRE : uniquement pour la migration des données ─────────
# À supprimer après la bascule (non utilisé par le runtime).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION (déploiement) — ne rien changer en local, ces valeurs vont dans les
# variables d'environnement de l'hébergeur (Render/Railway), PAS dans ce fichier.
# La base locale Postgres reste inchangée ; une base Supabase sera créée bientôt.
# ══════════════════════════════════════════════════════════════════════════════
#
# DATABASE_URL — chaîne "Connection pooling" (pgBouncer, port 6543) de Supabase :
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Pour `prisma migrate deploy`, utiliser plutôt la connexion directe (port 5432) :
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# CORS_ORIGIN — l'URL du front déployé (Vercel), ex. https://votre-app.vercel.app
#
# UPLOAD_DIR — chemin ABSOLU sur un disque persistant de l'hébergeur, ex.
#   /var/data/uploads   (les CV envoyés y sont écrits ; un FS éphémère les perdrait)
# JOBS_RUNS_DIR — idem si vous voulez conserver les runs, ex. /var/data/runs
