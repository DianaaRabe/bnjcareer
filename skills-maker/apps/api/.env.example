# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/skillsmaker?schema=public"

# Auth
JWT_SECRET="change-me-in-production"   # générer : openssl rand -hex 32
JWT_EXPIRES_IN="7d"

# Serveur
PORT=4100
CORS_ORIGIN="http://localhost:5173"

# ── Sources d'offres d'emploi ────────────────────────────────────────────────
# Une source sans clé est simplement masquée côté client (query jobSources).
# Scrapers Apify (Indeed, LinkedIn / HelloWork) — voir plus bas APIFY_API_TOKEN*.
# Sans mots-clés ni lieu, ces sources servent les runs pré-téléchargés de ce dossier
# au lieu de lancer un scraping (aucun crédit consommé au chargement de la page).
JOBS_RUNS_DIR="./data/runs"
# France Travail — compte + application sur https://francetravail.io (API "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""
# Jooble — clé gratuite sur https://jooble.org/api/about (69 pays)
JOOBLE_API_KEY=""

# ── Services portables ───────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_API_KEY_2=""
OPENROUTER_API_KEY=""

APIFY_API_TOKEN=""
APIFY_API_TOKEN_HELLOWORK=""

BREVO_API_KEY=""
BREVO_SMTP_API_KEY=""
BREVO_SENDER_EMAIL=""

MAKE_WELCOME_WEBHOOK_URL=""

# ── Supabase — TEMPORAIRE : uniquement pour la migration des données ─────────
# À supprimer après la bascule (non utilisé par le runtime).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
