# ── Web (Vite) ───────────────────────────────────────────────────────────────
# GraphQL endpoint of the API (runtime). The WebSocket (subscriptions) URL is
# derived from this by swapping http(s) -> ws(s), so it must point at the real
# /graphql path. Local dev falls back to http://localhost:4100/graphql if unset.
VITE_API_URL="http://localhost:4100/graphql"

# ── Build-time codegen (optional) ────────────────────────────────────────────
# By default codegen reads the committed SDL snapshot (schema.graphql) — no API
# needed, so the Vercel build works offline. Regenerate the snapshot after an API
# schema change: `npm run schema:export -w apps/api`.
# Set CODEGEN_SCHEMA_URL only if you want to introspect a LIVE API instead:
# CODEGEN_SCHEMA_URL="https://your-api-host.example.com/graphql"
